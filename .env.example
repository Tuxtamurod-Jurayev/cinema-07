# ==========================================
# 🤖 TELEGRAM BOT SOZLAMALARI
# ==========================================
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram ID lari (vergul bilan ajratilgan, masalan: 12345678,87654321)
# O'z ID ingizni bilish uchun Telegramda @userinfobot ga yozing
ADMIN_IDS=

# ==========================================
# 📡 SMS PROVIDER SOZLAMASI
# ==========================================
# Tanlovlar:
# 1) mock          - Sinov / test rejimi (SMS hisobisiz konsolda ko'rsatiladi)
# 2) android_local - capcom6/android-sms-gateway (bir xil Wi-Fi dagi Android telefon)
# 3) android_cloud - capcom6/android-sms-gateway (sms-gate.app orqali internet orqali)
# 4) smsgate       - pentagridsec/smsgate (GSM modem / USB SIM pool XML-RPC)
SMS_PROVIDER=mock

# ==========================================
# 1. ANDROID SMS GATEWAY (LOCAL REJIM)
# https://github.com/capcom6/android-sms-gateway
# ==========================================
# Android ilovada ko'rsatilgan IP va port (masalan: http://192.168.1.50:8080)
SMS_ANDROID_LOCAL_URL=http://192.168.1.50:8080
SMS_ANDROID_USERNAME=admin
SMS_ANDROID_PASSWORD=secret_password
# SIM-karta sloti: 1 yoki 2
SMS_SIM_SLOT=1

# ==========================================
# 2. ANDROID SMS GATEWAY (CLOUD REJIM)
# https://sms-gate.app
# ==========================================
SMS_ANDROID_CLOUD_URL=https://api.sms-gate.app
SMS_ANDROID_CLOUD_TOKEN=your_cloud_jwt_token_here

# ==========================================
# 3. PENTAGRID SEC SMSGATE (XML-RPC MODEM)
# https://github.com/pentagridsec/smsgate
# ==========================================
SMSGATE_URL=https://127.0.0.1:8443/
SMSGATE_TOKEN=your_token_send_sms_here
SMSGATE_MODEM_ID=
SMSGATE_VERIFY_SSL=False

# ==========================================
# 🗄 MA'LUMOTLAR BAZASI
# ==========================================
DB_FILE=sms_bot.db
